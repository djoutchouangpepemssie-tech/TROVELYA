# Architecture contracts (docs/CAHIER_DES_CHARGES.md section 5.4).
# Run with: uv run lint-imports
#
# Rule 1: a module never imports another module's repository, models or migrations; it goes
# through that module's public service.py. Every module under trovelya.modules needs its own
# contract below (tests/architecture/test_architecture.py fails otherwise).
# Rule 2: layers. The shared kernel and core never import business modules.

[importlinter]
root_package = trovelya

[importlinter:contract:layers]
name = Layers: scripts > entry points > modules > core > shared
type = layers
layers =
    trovelya.scripts
    trovelya.main | trovelya.workers
    trovelya.modules
    trovelya.core
    trovelya.shared

[importlinter:contract:module-ledger]
name = Other modules use ledger only through ledger.service
type = forbidden
source_modules =
    trovelya.modules.catalog
    trovelya.modules.orders
    trovelya.modules.identity
    trovelya.modules.media
    trovelya.modules.circumvention
forbidden_modules =
    trovelya.modules.ledger.repository
    trovelya.modules.ledger.models
    trovelya.modules.ledger.migrations

[importlinter:contract:module-catalog]
name = Other modules use catalog only through catalog.service
type = forbidden
source_modules =
    trovelya.modules.ledger
    trovelya.modules.orders
    trovelya.modules.identity
    trovelya.modules.media
    trovelya.modules.circumvention
forbidden_modules =
    trovelya.modules.catalog.repository
    trovelya.modules.catalog.models
    trovelya.modules.catalog.migrations

[importlinter:contract:module-orders]
name = Other modules use orders only through orders.service
type = forbidden
source_modules =
    trovelya.modules.ledger
    trovelya.modules.catalog
    trovelya.modules.identity
    trovelya.modules.media
    trovelya.modules.circumvention
forbidden_modules =
    trovelya.modules.orders.repository
    trovelya.modules.orders.models
    trovelya.modules.orders.migrations

[importlinter:contract:module-identity]
name = Other modules use identity only through identity.service
type = forbidden
# Direct imports only: media.api depends on identity.service.auth (the signed-in member),
# which reaches identity's own repository inside its module.
allow_indirect_imports = True
source_modules =
    trovelya.modules.ledger
    trovelya.modules.catalog
    trovelya.modules.orders
    trovelya.modules.media
    trovelya.modules.circumvention
forbidden_modules =
    trovelya.modules.identity.repository
    trovelya.modules.identity.models
    trovelya.modules.identity.migrations

[importlinter:contract:module-media]
name = Other modules use media only through media.service
type = forbidden
# media.service reaching its own repository is not a breach: identity goes through
# media.service.avatars (P2-T02c). Any other path to these modules still is.
ignore_imports =
    trovelya.modules.media.service.* -> trovelya.modules.media.repository
source_modules =
    trovelya.modules.ledger
    trovelya.modules.catalog
    trovelya.modules.orders
    trovelya.modules.identity
    trovelya.modules.circumvention
forbidden_modules =
    trovelya.modules.media.repository
    trovelya.modules.media.models
    trovelya.modules.media.migrations
    trovelya.modules.media.adapters

[importlinter:contract:catalog-universes]
name = catalog.universes imports nothing from the application (any module may read it)
type = forbidden
source_modules =
    trovelya.modules.catalog.universes
forbidden_modules =
    trovelya.core
    trovelya.shared
    trovelya.modules.catalog.service
    trovelya.modules.catalog.models
    trovelya.modules.circumvention
    trovelya.modules.identity
    trovelya.modules.ledger
    trovelya.modules.orders
    trovelya.modules.media

[importlinter:contract:module-circumvention]
name = Other modules use circumvention only through circumvention.service
type = forbidden
source_modules =
    trovelya.modules.ledger
    trovelya.modules.catalog
    trovelya.modules.orders
    trovelya.modules.identity
    trovelya.modules.media
forbidden_modules =
    trovelya.modules.circumvention.models
    trovelya.modules.circumvention.normalize
