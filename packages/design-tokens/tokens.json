{
  "$comment": "Single source of the TROVÉLYA design tokens (docs/CAHIER_DES_CHARGES.md section 6.2). Built into CSS variables (--trv-*) and a Tailwind 4 theme by src/build.ts.",
  "color": {
    "brand": { "light": "#1D2BFF", "dark": "#4D5BFF" },
    "brand-hover": { "light": "#1420C8", "dark": "#6A76FF" },
    "brand-soft": { "light": "#D9DDFF", "dark": "#1A1F4D" },
    "ink": { "light": "#0B0B0F", "dark": "#F5F5F7" },
    "ink-2": { "light": "#3A3A44", "dark": "#C7C7CF" },
    "ink-3": { "light": "#86868F", "dark": "#8E8E96" },
    "surface": { "light": "#FFFFFF", "dark": "#0B0B0F" },
    "surface-2": { "light": "#F2F2F7", "dark": "#16161C" },
    "line": { "light": "#E5E5EA", "dark": "#2A2A33" },
    "success": { "light": "#16A34A", "dark": "#22C55E" },
    "warning": { "light": "#F59E0B", "dark": "#FBBF24" },
    "danger": { "light": "#E5484D", "dark": "#FF6369" },
    "live": { "light": "#FF2D55", "dark": "#FF375F" },
    "glass": { "light": "rgba(255, 255, 255, 0.62)", "dark": "rgba(22, 22, 28, 0.55)" },
    "glass-border": { "light": "rgba(255, 255, 255, 0.5)", "dark": "rgba(255, 255, 255, 0.08)" }
  },
  "radius": { "sm": "8px", "md": "12px", "lg": "16px", "xl": "24px", "pill": "999px" },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "shadow": {
    "1": "0 1px 2px rgba(11, 11, 15, 0.06), 0 1px 3px rgba(11, 11, 15, 0.08)",
    "2": "0 4px 16px rgba(11, 11, 15, 0.08), 0 1px 4px rgba(11, 11, 15, 0.06)",
    "3": "0 16px 48px rgba(11, 11, 15, 0.16), 0 4px 12px rgba(11, 11, 15, 0.08)"
  },
  "motion": { "fast": "120ms", "base": "200ms", "slow": "320ms" },
  "easing": { "standard": "cubic-bezier(.2,.8,.2,1)" },
  "font": {
    "sans": "var(--font-geist-sans), system-ui, sans-serif",
    "mono": "var(--font-geist-mono), ui-monospace, monospace"
  }
}
