# TROVÉLYA API configuration (docs/CAHIER_DES_CHARGES.md section 5.8).
# Copy to .env for local development. Never commit real secrets.

ENV=local
DATABASE_URL=postgresql+asyncpg://trovelya:trovelya@localhost:5432/trovelya
DATABASE_READ_URL=
REDIS_URL=redis://localhost:6379/0
# 64 random bytes, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SECRET_KEY=
SESSION_TTL_DAYS=30
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SHIPPING_PROVIDER=fake

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
CDN_BASE_URL=

EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
EMAIL_FROM=no-reply@localhost
SMTP_URL=smtp://localhost:1025

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=TROVÉLYA

AI_PROVIDER=fake
AI_API_KEY=
AI_REGION=eu
EMBEDDING_MODEL=
EMBEDDING_DIM=768

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Web (Vercel) : valeurs publiques, visibles dans le navigateur
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SENTRY_DSN=
FEATURE_FLAGS_DEFAULT={}

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
