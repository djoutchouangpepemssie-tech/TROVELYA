# TROVÉLYA API configuration (docs/CAHIER_DES_CHARGES.md section 5.8).
# Copy to .env for local development. Never commit real secrets.

ENV=local
DATABASE_URL=postgresql+asyncpg://trovelya:trovelya@localhost:5432/trovelya
DATABASE_READ_URL=
REDIS_URL=redis://localhost:6379/0
# 64 random bytes, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SECRET_KEY=
# Shared with the web relay (apps/web/.env.local), at least 32 characters (ADR-0015)
PROXY_SHARED_SECRET=
SESSION_TTL_DAYS=30
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SHIPPING_PROVIDER=fake

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
CDN_BASE_URL=

# smtp (Mailpit in local), resend (staging), fake (tests) — ADR-0017
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
EMAIL_FROM=TROVÉLYA <no-reply@localhost>
SMTP_URL=smtp://localhost:1025
# At least 32 random characters; keys per purpose are derived from it (shared/crypto.py)
FIELD_ENCRYPTION_KEY=
# Cloudflare Turnstile on sign-in requests; leave empty to disable (P1 decision Q7)
TURNSTILE_SECRET_KEY=

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=TROVÉLYA

AI_PROVIDER=fake
AI_API_KEY=
AI_REGION=eu
EMBEDDING_MODEL=
EMBEDDING_DIM=768

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Web (Vercel, apps/web/.env.local en local)
# Server-only: where the same-origin relay /api/* sends requests (ADR-0015)
API_INTERNAL_URL=http://localhost:8000
# Public values, visible in the browser
NEXT_PUBLIC_SENTRY_DSN=
FEATURE_FLAGS_DEFAULT={}

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
