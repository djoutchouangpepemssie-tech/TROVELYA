# TROVÉLYA API configuration (docs/CAHIER_DES_CHARGES.md section 5.8).
# Copy to .env for local development. Never commit real secrets.

ENV=local
DATABASE_URL=postgresql+asyncpg://trovelya:trovelya@localhost:5432/trovelya
DATABASE_READ_URL=
REDIS_URL=redis://localhost:6379/0
# 64 random bytes, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SECRET_KEY=
# Shared with the web relay (apps/web/.env.local), at least 32 characters (ADR-0015)
PROXY_SHARED_SECRET=
SESSION_TTL_DAYS=30
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SHIPPING_PROVIDER=fake

# smtp (Mailpit in local), resend (staging), fake (tests) — ADR-0017
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
EMAIL_FROM=TROVÉLYA <no-reply@localhost>
SMTP_URL=smtp://localhost:1025
# At least 32 random characters; keys per purpose are derived from it (shared/crypto.py)
FIELD_ENCRYPTION_KEY=
# Cloudflare Turnstile on sign-in requests; leave empty to disable (P1 decision Q7)
TURNSTILE_SECRET_KEY=
# Geocoding (P1-T06a): geoplateforme (IGN, data.geopf.fr) or fake (offline, three places).
GEOCODER_PROVIDER=geoplateforme
# Object storage (ADR-0019): memory (nothing stored, unit tests) or s3 (Garage locally:
# `bash infra/garage/init.sh` prints the values; Cloudflare R2 on Railway, infra/r2/README.md).
STORAGE_PROVIDER=memory
STORAGE_ENDPOINT=
STORAGE_REGION=garage
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_ORIGINALS=trovelya-originals
STORAGE_BUCKET_VARIANTS=trovelya-variants
MEDIA_PUBLIC_URL=http://trovelya-variants.web.garage.localhost:3902

# Sign-in with Google (P1-T03): OAuth client (Google Cloud, "Web application"). Off while
# unset; also needs the feature flag auth.oauth_google (FEATURE_FLAGS_DEFAULT on staging).
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# Sign in with Apple (P1-T03b): Services ID, team id, key id and the .p8 key (PEM). Off while
# unset (no Apple Developer account yet, decision Q4); also needs the flag auth.oauth_apple.
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=
# Passkeys (P1-T04): relying party id (host of WEB_ORIGIN when empty), its display name, and
# the accepted origins as a JSON list ([WEB_ORIGIN] when empty). Flag auth.passkeys.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=TROVÉLYA
WEBAUTHN_ORIGINS=["http://localhost:3000"]

AI_PROVIDER=fake
AI_API_KEY=
AI_REGION=eu
EMBEDDING_MODEL=
EMBEDDING_DIM=768

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Web (Vercel, apps/web/.env.local en local)
# Server-only: where the same-origin relay /api/* sends requests (ADR-0015)
API_INTERNAL_URL=http://localhost:8000
# Server-only, for the CSP (ADR-0019): where photos are uploaded and served from
MEDIA_UPLOAD_ORIGIN=http://localhost:3900
# and MEDIA_PUBLIC_URL, the same value as the API's above
# Public values, visible in the browser
NEXT_PUBLIC_SENTRY_DSN=
FEATURE_FLAGS_DEFAULT={}

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
