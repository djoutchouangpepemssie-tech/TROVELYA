{
  "name": "trovelya",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "cd apps/api && uv run python -m trovelya.scripts.export_openapi ../../docs/api/openapi.json && cd ../.. && pnpm --filter @trovelya/api-client generate"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  }
}
